{
  "name": "@cocreate/server-sitemap",
  "version": "1.12.0",
  "description": "Server-side XML sitemap engine with image, video, and news metadata extraction and dynamic sitemap sharding.",
  "keywords": [
    "server-sitemap",
    "xml-sitemap",
    "seo-automation",
    "sitemap-sharding",
    "google-news-sitemap",
    "video-sitemap",
    "image-sitemap",
    "html-parsing",
    "cocreate-server"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "server"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "Server-side XML sitemap engine with image, video, and news metadata extraction and dynamic sitemap sharding.",
      "source": "src/index.js",
      "declarative": {
        "attributes": [
          {
            "name": "alt"
          },
          {
            "name": "content"
          },
          {
            "name": "description"
          },
          {
            "name": "lang"
          },
          {
            "name": "name"
          },
          {
            "name": "poster"
          },
          {
            "name": "sitemap-caption"
          },
          {
            "name": "sitemap-description"
          },
          {
            "name": "sitemap-duration"
          },
          {
            "name": "sitemap-genres"
          },
          {
            "name": "sitemap-geo-location"
          },
          {
            "name": "sitemap-keywords"
          },
          {
            "name": "sitemap-publication-date"
          },
          {
            "name": "sitemap-publication-language"
          },
          {
            "name": "sitemap-publication-name"
          },
          {
            "name": "sitemap-thumbnail"
          },
          {
            "name": "sitemap-title"
          },
          {
            "name": "src"
          },
          {
            "name": "title"
          }
        ]
      },
      "api": {
        "exports": [
          "buildSitemapXml",
          "check",
          "createEntry",
          "encodeXML",
          "parseHtml"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/CoCreate-server-sitemap.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreateJS/CoCreate-server-sitemap/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/server-sitemap",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/utils": "^1.54.0"
  }
}
