{
  "name": "@cocreate/sitemap",
  "version": "1.8.0",
  "description": "Automated stateless XML sitemap engine with multi-format media extraction (Images, Videos, Google News) and dynamic data-sharding for scalable document architectures.",
  "keywords": [
    "sitemap-generator",
    "xml-sitemap",
    "seo-automation",
    "sitemap-sharding",
    "google-news-sitemap",
    "video-sitemap",
    "image-sitemap",
    "html-parsing",
    "stateless-utility",
    "cocreate-module"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreate-app/CoCreate-sitemap.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-sitemap/issues"
  },
  "homepage": "https://cocreate.app/docs/sitemap",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/utils": "^1.44.3"
  }
}
